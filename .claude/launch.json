{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cryplounge-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "cryplounge-api",
      "runtimeExecutable": "npm",
