{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // Only `src` is compiled. `prisma/seed.ts` imports the frontend's seed data
  // by relative path and is executed with tsx, so including it here would drag
  // files from outside this project into the build and push `rootDir` up —
  // which silently relocates dist/main.js and breaks `start:prod`.
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", "prisma"]
}
