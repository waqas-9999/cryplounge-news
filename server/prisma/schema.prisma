generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Staff accounts. There are no reader accounts — the public site is anonymous.
model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  /// bcrypt hash. Never a plaintext password, never returned by the API.
  passwordHash        String
  role                Role                 @default(VIEWER)
  isActive            Boolean              @default(true)
  avatarUrl           String?
  lastLoginAt         DateTime?
  /// Set when an admin invites a user; cleared once they set a password
  /// (new account) or once a role grant is accepted (existing account).
  inviteToken         String?              @unique
  inviteExpiresAt     DateTime?
  passwordResetToken  String?              @unique
  passwordResetAt     DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  /// Set alongside inviteToken when a super admin grants an *additional*
  /// role to an already-active account rather than inviting a new one.
  /// Accepting the invite adds this role to `additionalRoles` and clears
  /// both fields; it never touches `role` or the password.
  pendingRoleKey      String?
  /// Short public-facing bio, shown on published articles under their byline.
  bio                 String?
  articles            Article[]            @relation("ArticleCreatedBy")
  auditLogs           AuditLog[]
  legalPages          LegalPage[]
  uploads             Media[]
  newsletterCampaigns NewsletterCampaign[] @relation("NewsletterCampaignCreatedBy")
  refreshTokens       RefreshToken[]
  sessions            Session[]
  additionalRoles     RoleDefinition[]     @relation("UserAdditionalRoles")

  @@index([role])
}

/// Server-side sessions. The cookie holds only the opaque token.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Bylines. Separate from User: not every author has a login, and a byline
/// outlives the staff account behind it.
model Author {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  bio       String?
  avatarUrl String?
  email     String?
  x         String?
  linkedin  String?
  website   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  articles  Article[]
  research  Research[]
}

/// One category table for every content type, discriminated by `kind`, so the
/// CMS manages categories once and reuses them everywhere.
model Category {
  id          String       @id @default(cuid())
  kind        CategoryKind
  slug        String
  name        String
  description String?
  /// Manual ordering in navigation and pickers.
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  articles    Article[]
  events      Event[]
  projects    Project[]
  regulations Regulation[]
  research    Research[]

  @@unique([kind, slug])
  @@index([kind])
}

/// Global, reusable across every content type.
model Tag {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  createdAt   DateTime     @default(now())
  articles    Article[]    @relation("ArticleToTag")
  events      Event[]      @relation("EventToTag")
  founders    Founder[]    @relation("FounderToTag")
  projects    Project[]    @relation("ProjectToTag")
  regulations Regulation[] @relation("RegulationToTag")
  research    Research[]   @relation("ResearchToTag")
}

model Article {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  summary          String
  content          String
  status           ContentStatus    @default(DRAFT)
  publishedAt      DateTime?
  /// Set when status is SCHEDULED; a job publishes at this time.
  scheduledFor     DateTime?
  featured         Boolean          @default(false)
  pinned           Boolean          @default(false)
  /// Manual ordering within a listing; higher sorts first.
  priority         Int              @default(0)
  readMinutes      Int              @default(3)
  categoryId       String?
  authorId         String?
  createdById      String?
  /// The AI agent that filed this article, when one did. The authoritative
  /// agent-origin marker: `createdById IS NULL` is not (it is SetNull on user
  /// deletion). Null must be treated as "not agent-filed".
  createdByAgentId String?
  featuredImageId  String?
  seoTitle         String?
  seoDescription   String?
  canonicalUrl     String?
  noindex          Boolean          @default(false)
  /// Soft delete. Rows are hidden from every query rather than removed,
  /// so an accidental delete is recoverable and inbound links do not break.
  deletedAt        DateTime?
  deletedById      String?
  updatedById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  author           Author?          @relation(fields: [authorId], references: [id])
  category         Category?        @relation(fields: [categoryId], references: [id])
  createdBy        User?            @relation("ArticleCreatedBy", fields: [createdById], references: [id])
  createdByAgent   AiAgent?         @relation("ArticleCreatedByAgent", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  featuredImage    Media?           @relation(fields: [featuredImageId], references: [id])
  versions         ArticleVersion[]
  visuals          ArticleVisual[]
  events           Event[]          @relation("ArticleToEvent")
  founders         Founder[]        @relation("ArticleToFounder")
  labels           Label[]          @relation("ArticleToLabel")
  projects         Project[]        @relation("ArticleToProject")
  regulations      Regulation[]     @relation("ArticleToRegulation")
  research         Research[]       @relation("ArticleToResearch")
  tags             Tag[]            @relation("ArticleToTag")

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
  @@index([deletedAt])
  @@index([createdByAgentId, status])
}

/// Immutable snapshot taken on each save, powering version history.
model ArticleVersion {
  id         String   @id @default(cuid())
  articleId  String
  title      String
  summary    String
  content    String
  /// User id captured at write time; kept even if the account is deleted.
  editedById String?
  createdAt  DateTime @default(now())
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

/// A visual placed in an article.
///
/// Deliberately thin: the asset itself — path, alt text, caption, dimensions —
/// lives on `Media` and is not copied here. This model answers only "which
/// visual, where, in what order", so a caption edited on the Media record does
/// not have to be reconciled with a duplicate.
model ArticleVisual {
  id              String                 @id @default(cuid())
  articleId       String
  mediaId         String
  type            ArticleVisualType
  placement       ArticleVisualPlacement @default(INLINE)
  /// Render order within a placement. Never rely on insertion order.
  position        Int                    @default(0)
  /// Why this visual belongs, from the writer's brief. Editorial rationale,
  /// not reader-facing text.
  relevanceReason String?
  /// Chart specification and source, when this visual is a chart. Kept as the
  /// record of what was plotted; the rendered PNG on `Media` is what ships.
  chartMeta       Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  article         Article                @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media           Media                  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([articleId, mediaId])
  @@index([articleId, placement, position])
}

model Project {
  id                String        @id @default(cuid())
  slug              String        @unique
  name              String
  tagline           String
  about             String
  keyFeatures       String[]
  categoryId        String?
  blockchain        String
  supportedNetworks String[]
  nativeToken       String?
  launchYear        Int?
  status            ProjectStatus @default(LIVE)
  verified          Boolean       @default(false)
  openSource        Boolean       @default(false)
  featured          Boolean       @default(false)
  editorsPick       Boolean       @default(false)
  /// Emoji mark and brand colour, used until real logo assets exist.
  logo              String
  accent            String        @default("#EFB81A")
  logoImageId       String?
  coverImageId      String?
  website           String?
  x                 String?
  github            String?
  discord           String?
  telegram          String?
  linkedin          String?
  youtube           String?
  medium            String?
  blog              String?
  docs              String?
  whitepaper        String?
  explorer          String?
  api               String?
  seoTitle          String?
  seoDescription    String?
  noindex           Boolean       @default(false)
  /// Soft delete. Rows are hidden from every query rather than removed,
  /// so an accidental delete is recoverable and inbound links do not break.
  deletedAt         DateTime?
  deletedById       String?
  updatedById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  submittedByEmail  String?
  /// Set on public submissions (no user account required to submit). Null for
  /// projects created directly by an editor.
  submittedByName   String?
  /// Curated for the Ecosystem homepage "Trending Projects" rail. Editorial,
  /// not derived from any traffic metric.
  trending          Boolean       @default(false)
  category          Category?     @relation(fields: [categoryId], references: [id])
  coverImage        Media?        @relation("ProjectCover", fields: [coverImageId], references: [id])
  logoImage         Media?        @relation("ProjectLogo", fields: [logoImageId], references: [id])
  articles          Article[]     @relation("ArticleToProject")
  events            Event[]       @relation("EventToProject")
  founders          Founder[]     @relation("FounderToProject")
  regulations       Regulation[]  @relation("ProjectToRegulation")
  research          Research[]    @relation("ProjectToResearch")
  tags              Tag[]         @relation("ProjectToTag")

  @@index([categoryId])
  @@index([featured])
  @@index([blockchain])
  @@index([status])
  @@index([deletedAt])
}

/// A hand-curated grouping of projects shown on the Ecosystem homepage. The
/// grouping lives in the database (not frontend seed data) so it is editable
/// and reorderable later from the admin panel; `projectSlugs` lists the slugs
/// of the `Project` rows it contains.
model ProjectCollection {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String?
  projectSlugs String[]
  /// Lower numbers render first.
  position     Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, position])
}

model Research {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String
  content        String
  /// Source list rendered as the References block.
  references     String[]
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  featured       Boolean       @default(false)
  categoryId     String?
  authorId       String?
  coverImageId   String?
  seoTitle       String?
  seoDescription String?
  noindex        Boolean       @default(false)
  /// Soft delete. Rows are hidden from every query rather than removed,
  /// so an accidental delete is recoverable and inbound links do not break.
  deletedAt      DateTime?
  deletedById    String?
  updatedById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  author         Author?       @relation(fields: [authorId], references: [id])
  category       Category?     @relation(fields: [categoryId], references: [id])
  coverImage     Media?        @relation(fields: [coverImageId], references: [id])
  articles       Article[]     @relation("ArticleToResearch")
  events         Event[]       @relation("EventToResearch")
  projects       Project[]     @relation("ProjectToResearch")
  tags           Tag[]         @relation("ResearchToTag")

  @@index([status, publishedAt])
}

model Regulation {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String
  content        String
  /// ISO 3166-1 alpha-2, or null for supranational (EU, G20).
  countryCode    String?
  countryName    String?
  region         String?
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  categoryId     String?
  seoTitle       String?
  seoDescription String?
  noindex        Boolean       @default(false)
  /// Soft delete. Rows are hidden from every query rather than removed,
  /// so an accidental delete is recoverable and inbound links do not break.
  deletedAt      DateTime?
  deletedById    String?
  updatedById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  category       Category?     @relation(fields: [categoryId], references: [id])
  articles       Article[]     @relation("ArticleToRegulation")
  events         Event[]       @relation("EventToRegulation")
  projects       Project[]     @relation("ProjectToRegulation")
  tags           Tag[]         @relation("RegulationToTag")

  @@index([status, publishedAt])
  @@index([countryCode])
}

model Event {
  id               String         @id @default(cuid())
  slug             String         @unique
  name             String
  summary          String
  content          String
  startsAt         DateTime
  endsAt           DateTime?
  /// IANA zone, e.g. "Europe/London".
  timezone         String         @default("UTC")
  mode             EventMode      @default(OFFLINE)
  venue            String?
  city             String?
  country          String?
  onlineUrl        String?
  registerUrl      String?
  status           ContentStatus  @default(DRAFT)
  featured         Boolean        @default(false)
  categoryId       String?
  bannerImageId    String?
  sponsors         String[]
  seoTitle         String?
  seoDescription   String?
  noindex          Boolean        @default(false)
  /// Soft delete. Rows are hidden from every query rather than removed,
  /// so an accidental delete is recoverable and inbound links do not break.
  deletedAt        DateTime?
  deletedById      String?
  updatedById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  /// Set when an editor cancels/postpones a published event. Deliberately not
  /// part of `ContentStatus`: cancelling/postponing doesn't change who can see
  /// the page, just how it's labeled, so it's presentation metadata rather
  /// than a workflow state.
  cancelledAt      DateTime?
  /// Free-text so international / crypto-denominated prices don't need a
  /// currency engineering pass (e.g. "$50", "0.05 ETH", "Free").
  isFree           Boolean        @default(true)
  /// e.g. "English" -- free text, not an enum, since this is display-only.
  language         String?
  organizerId      String?
  postponedAt      DateTime?
  submittedByEmail String?
  /// Set on public submissions (no user account required to submit). Null for
  /// events created directly by an editor.
  submittedByName  String?
  telegramChannel  String?
  ticketPrice      String?
  /// Blockchain ecosystems the event covers, e.g. ["Ethereum", "Solana"].
  /// A list rather than a relation: these are a small, slowly-changing
  /// vocabulary used for filtering and analytics, not editable content.
  chains           String[]
  bannerImage      Media?         @relation(fields: [bannerImageId], references: [id])
  category         Category?      @relation(fields: [categoryId], references: [id])
  organizer        Organizer?     @relation(fields: [organizerId], references: [id])
  speakers         EventSpeaker[]
  articles         Article[]      @relation("ArticleToEvent")
  founders         Founder[]      @relation("EventToFounder")
  projects         Project[]      @relation("EventToProject")
  regulations      Regulation[]   @relation("EventToRegulation")
  research         Research[]     @relation("EventToResearch")
  tags             Tag[]          @relation("EventToTag")

  @@index([startsAt])
  @@index([status])
  @@index([organizerId])
}

model Organizer {
  id               String    @id @default(cuid())
  name             String
  description      String?
  logoId           String?
  contactPerson    String?
  contactEmail     String?
  telegramUsername String?
  telegramChannel  String?
  website          String?
  x                String?
  linkedin         String?
  verified         Boolean   @default(false)
  /// Soft delete. Rows are hidden from every query rather than removed, so an
  /// accidental delete is recoverable and inbound links do not break.
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  events           Event[]
  logo             Media?    @relation(fields: [logoId], references: [id])

  @@index([verified])
}

model EventSpeaker {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  title     String?
  bio       String?
  photoUrl  String?
  /// Optional link to a founder profile when the speaker is one.
  founderId String?
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  founder   Founder? @relation(fields: [founderId], references: [id])

  @@index([eventId])
}

model Founder {
  id               String         @id @default(cuid())
  slug             String         @unique
  name             String
  role             String
  company          String?
  bio              String
  excerpt          String
  photoId          String?
  website          String?
  x                String?
  linkedin         String?
  github           String?
  region           String?
  status           ContentStatus  @default(DRAFT)
  publishedAt      DateTime?
  featured         Boolean        @default(false)
  seoTitle         String?
  seoDescription   String?
  noindex          Boolean        @default(false)
  /// Soft delete. Rows are hidden from every query rather than removed,
  /// so an accidental delete is recoverable and inbound links do not break.
  deletedAt        DateTime?
  deletedById      String?
  updatedById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  submittedByEmail String?
  /// Set only on public "submit your story" submissions.
  submittedByName  String?
  /// Sector the founder works in, e.g. "DeFi", "Infrastructure", "Gaming".
  /// Drives the industry breakdown in founder analytics.
  industry         String?
  /// Editorially confirmed identity. Mirrors `Organizer.verified`.
  verified         Boolean        @default(false)
  speakerAt        EventSpeaker[]
  photo            Media?         @relation(fields: [photoId], references: [id])
  articles         Article[]      @relation("ArticleToFounder")
  events           Event[]        @relation("EventToFounder")
  projects         Project[]      @relation("FounderToProject")
  tags             Tag[]          @relation("FounderToTag")

  @@index([status])
}

model Media {
  id                    String             @id @default(cuid())
  /// Opaque identifier the active StorageProvider uses to build a URL or
  /// delete the file: a relative disk path for LocalStorageProvider, or a
  /// Cloudinary public ID for CloudinaryStorageProvider. Never a full URL.
  path                  String             @unique
  filename              String
  mimeType              String
  /// Bytes.
  size                  Int
  width                 Int?
  height                Int?
  altText               String?
  title                 String?
  folder                String             @default("/")
  uploadedById          String?
  /// The AI agent that uploaded this file, when one did. Not backfilled.
  uploadedByAgentId     String?
  /// Soft delete. Rows are hidden from every query rather than removed,
  /// so an accidental delete is recoverable and inbound links do not break.
  deletedAt             DateTime?
  deletedById           String?
  updatedById           String?
  createdAt             DateTime           @default(now())
  /// Editorial caption: what the reader is looking at and why it is relevant.
  /// Distinct from altText, which describes the image for a screen reader.
  caption               String?
  /// True only for images this newsroom generated. Drives the "AI-generated
  /// illustration" disclosure in the UI; deliberately never drawn into the
  /// pixels, which stay clean editorial artwork.
  isAiGenerated         Boolean            @default(false)
  generationProvider    String?
  generationModel       String?
  /// Verdict from the Gemini vision reviewer in `cryplounge-ai`.
  reviewStatus          MediaReviewStatus?
  /// 0-100 from `assessImageQuality`, kept so an editor can compare candidates.
  reviewScore           Int?
  /// Why a candidate was refused, in editorial language rather than model output.
  reviewReasons         String[]           @default([])
  /// The article this candidate was generated for.
  ///
  /// Not a relation: a candidate outlives the attachment decision and must not
  /// cascade when an article changes its featured image. It exists so the
  /// attach endpoint can verify a candidate belongs to the article it is being
  /// attached to, rather than trusting the browser's `mediaId`.
  generatedForArticleId String?
  articleFeatures       Article[]
  articleVisuals        ArticleVisual[]
  eventBanners          Event[]
  founderPhotos         Founder[]
  uploadedBy            User?              @relation(fields: [uploadedById], references: [id])
  uploadedByAgent       AiAgent?           @relation("MediaUploadedByAgent", fields: [uploadedByAgentId], references: [id], onDelete: SetNull)
  organizerLogos        Organizer[]
  projectCovers         Project[]          @relation("ProjectCover")
  projectLogos          Project[]          @relation("ProjectLogo")
  researchCovers        Research[]

  @@index([folder])
  @@index([generatedForArticleId, createdAt(sort: Desc)])
  @@index([uploadedByAgentId])
}

/// Key/value store for site settings. A row per setting keeps the admin
/// generic and avoids a migration every time a toggle is added.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Configurable homepage bands: enable, reorder, configure.
model HomepageSection {
  id       String  @id @default(cuid())
  /// Stable identifier the frontend switches on, e.g. "ecosystem_spotlight".
  key      String  @unique
  title    String
  enabled  Boolean @default(true)
  position Int     @default(0)
  /// Section-specific options (item count, source category, ...).
  config   Json?

  @@index([position])
}

model NavigationItem {
  id       String           @id @default(cuid())
  /// "header" or "footer".
  location String
  label    String
  href     String
  position Int              @default(0)
  parentId String?
  parent   NavigationItem?  @relation("NavChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavChildren")

  @@index([location, position])
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  /// 301 or 302.
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}

/// Legal / policy pages — Terms, Privacy, Editorial Policy, etc. Content is
/// admin-authored HTML, never hardcoded in the frontend, so Legal can amend
/// wording without a deploy.
model LegalPage {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  content        String
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  updatedById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  updatedBy      User?         @relation(fields: [updatedById], references: [id])

  @@index([status])
}

model Language {
  code         String        @id
  name         String
  isDefault    Boolean       @default(false)
  enabled      Boolean       @default(true)
  translations Translation[]
}

model Translation {
  id           String   @id @default(cuid())
  languageCode String
  /// Dotted key, e.g. "nav.news".
  key          String
  value        String
  language     Language @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@unique([languageCode, key])
  @@index([languageCode])
}

model AdSlot {
  id             String    @id @default(cuid())
  /// Placement identifier the frontend renders into, e.g. "article_sidebar".
  placement      String
  campaignName   String
  status         AdStatus  @default(PAUSED)
  startsAt       DateTime?
  endsAt         DateTime?
  priority       Int       @default(0)
  destinationUrl String?
  imageId        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([placement, status])
}

/// Append-only. Rows are never updated or deleted by the application.
model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  /// Model name, e.g. "Article".
  entity    String?
  entityId  String?
  /// Human-readable summary shown in the log table.
  summary   String
  userId    String?
  /// Denormalised so the log survives account deletion.
  userEmail String?
  ipAddress String?
  metadata  Json?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([action])
  @@index([entity, entityId])
}

/// Rotating refresh tokens. One row per issued token; rotation revokes the
/// previous row, so a stolen token is usable at most once before detection.
model RefreshToken {
  id           String    @id @default(cuid())
  /// SHA-256 of the token. The raw value is only ever held by the client.
  tokenHash    String    @unique
  userId       String
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Set when this token was rotated, pointing at its replacement. Reuse of a
  /// rotated token indicates theft and invalidates the whole chain.
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Granular permission, e.g. "news.publish". Seeded, not hardcoded in code.
model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  /// Admin grouping: "News", "Ecosystem", "Settings".
  module      String
  description String?
  roles       RolePermission[]

  @@index([module])
}

/// Role definitions live in the database so permissions are configurable
/// rather than compiled in.
model RoleDefinition {
  id                    String           @id @default(cuid())
  key                   String           @unique
  name                  String
  description           String?
  /// System roles (the built-in `Role` enum values) cannot be deleted or
  /// renamed, and only their permission grants can be edited.
  isSystem              Boolean          @default(false)
  permissions           RolePermission[]
  additionalRoleHolders User[]           @relation("UserAdditionalRoles")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Editorial labels: Breaking, Exclusive, Analysis.
model Label {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  /// Badge colour in the UI.
  color    String    @default("#EFB81A")
  articles Article[] @relation("ArticleToLabel")
}

/// A trusted external AI publisher. The platform never generates content; it
/// receives, validates and publishes what an agent submits.
model AiAgent {
  id                 String                @id @default(cuid())
  name               String
  slug               String                @unique
  description        String?
  environment        AgentEnvironment      @default(STAGING)
  isActive           Boolean               @default(false)
  /// Public identifier sent in the X-Agent-Key header.
  apiKey             String                @unique
  /// Argon2 hash of the secret. The plaintext is shown once, at creation.
  apiSecretHash      String
  /// Optional allowlist; empty means any source address.
  allowedIps         String[]
  defaultPublishMode AgentPublishMode      @default(DRAFT)
  /// Permission keys this agent holds, e.g. ["news.create","media.upload"].
  permissions        String[]
  rateLimitPerMinute Int                   @default(60)
  lastConnectedAt    DateTime?
  lastPublishedAt    DateTime?
  lastError          String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  idempotencyKeys    AgentIdempotencyKey[]
  requests           AgentRequestLog[]
  webhooks           Webhook[]
  articles           Article[]             @relation("ArticleCreatedByAgent")
  uploads            Media[]               @relation("MediaUploadedByAgent")

  @@index([isActive])
}

/// Every agent call, successful or not.
/// One idempotent submission, keyed by the caller's `Idempotency-Key`.
///
/// AI workflows retry: a network timeout, a worker restart, a scheduler that
/// fires twice, a webhook redelivery. Without this table each retry of a
/// submission that actually succeeded creates a *second* article, because the
/// caller never learned about the first.
///
/// The unique constraint is what makes this work. Two concurrent requests race
/// to insert the same key; exactly one wins and the loser gets a unique-
/// constraint violation, which is handled as "someone else is doing this"
/// rather than as an error. Checking-then-inserting would leave a window
/// between the two where both callers see nothing and both proceed.
model AgentIdempotencyKey {
  id             String            @id @default(cuid())
  agentId        String
  /// Caller-supplied, e.g. "newsroom-job-20260813-001".
  key            String
  /// Which operation the key belongs to, so the same key on a different
  /// endpoint is a genuinely different request rather than a false match.
  operation      String
  status         IdempotencyStatus @default(PROCESSING)
  /// Set once the work succeeds. Null while PROCESSING or after FAILED.
  resultEntity   String?
  resultEntityId String?
  /// The response body to replay on a repeat call, so a retry returns exactly
  /// what the first call returned instead of a different shape.
  response       Json?
  /// Why it failed, so a retry is an informed decision rather than a guess.
  error          String?
  /// Fingerprint of the request body. A caller reusing one key for different
  /// content is a bug worth refusing rather than silently returning the old
  /// article.
  requestHash    String?
  createdAt      DateTime          @default(now())
  completedAt    DateTime?
  agent          AiAgent           @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, operation, key])
  @@index([status, createdAt])
  @@index([createdAt])
}

model AgentRequestLog {
  id               String   @id @default(cuid())
  agentId          String?
  /// Denormalised so the log survives agent deletion.
  agentName        String?
  endpoint         String
  method           String
  statusCode       Int
  ipAddress        String?
  contentType      String?
  /// Id of the row the request created or updated, when it succeeded.
  resultEntity     String?
  resultEntityId   String?
  /// Validation failures, so agent authors can debug their payloads.
  validationErrors Json?
  durationMs       Int
  createdAt        DateTime @default(now())
  agent            AiAgent? @relation(fields: [agentId], references: [id])

  @@index([agentId, createdAt])
  @@index([statusCode])
}

model Webhook {
  id         String            @id @default(cuid())
  agentId    String?
  url        String
  events     WebhookEvent[]
  /// Used to sign the payload so the receiver can verify origin.
  secret     String
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  agent      AiAgent?          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id         String       @id @default(cuid())
  webhookId  String
  event      WebhookEvent
  statusCode Int?
  error      String?
  attempts   Int          @default(1)
  createdAt  DateTime     @default(now())
  webhook    Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

/// Daily per-entity view counts. Aggregated rather than row-per-hit so the
/// table stays small enough to query directly for "most read".
model ViewCount {
  id       String   @id @default(cuid())
  /// "Article" | "Project" | "Research" | "Regulation" | "Event" | "Founder"
  entity   String
  entityId String
  /// Midnight UTC of the day being counted.
  day      DateTime @db.Date
  count    Int      @default(0)

  @@unique([entity, entityId, day])
  @@index([entity, day])
}

/// Recorded search queries, powering the search analytics reports.
model SearchQuery {
  id          String   @id @default(cuid())
  term        String
  resultCount Int
  createdAt   DateTime @default(now())

  @@index([term])
  @@index([createdAt])
}

/// One anonymous analytics event (page view, article view, scroll milestone,
/// share, …). Sessions are reconstructed by `sessionId`; a hashed `visitorId`
/// distinguishes new vs returning without storing personal data. Geographic
/// and device fields are only populated when the client supplies them — the
/// UI shows "Not available" rather than invented values.
model AnalyticsEvent {
  id               String   @id @default(cuid())
  /// e.g. page_view | article_view | article_scroll | share | search | …
  type             String
  /// Anonymous session id generated client-side per visit.
  sessionId        String
  /// Hashed anonymous visitor id (persists across sessions).
  visitorId        String?
  path             String?
  referrer         String?
  /// Captured from Accept-Language region when available.
  country          String?
  region           String?
  city             String?
  deviceType       String?
  browser          String?
  os               String?
  screenResolution String?
  language         String?
  /// Content context (entity type + id, e.g. Article + article id).
  entity           String?
  entityId         String?
  categoryId       String?
  authorId         String?
  /// Scroll depth in % for article_scroll milestones.
  scrollDepth      Int?
  /// Extra structured payload (share platform, search term, …).
  meta             Json?
  timestamp        DateTime @default(now())

  @@index([type, timestamp])
  @@index([sessionId, timestamp])
  @@index([entity, entityId, timestamp])
  @@index([country, timestamp])
  @@index([visitorId, timestamp])
}

/// A message submitted through the public Contact Us form. Read in the admin
/// panel — the site sends no outbound mail, so this is the only record of it.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
  @@index([email])
}

/// A newsletter subscriber. Created through the public subscribe form and
/// managed in the admin panel. The email is stored lowercased and unique, so
/// duplicate subscriptions are impossible at the database level.
model NewsletterSubscriber {
  id           String           @id @default(cuid())
  email        String           @unique
  /// Optional first name collected by the public subscribe form.
  name         String?
  status       NewsletterStatus @default(ACTIVE)
  /// When the address was (last) subscribed; reset when a subscriber who
  /// unsubscribed re-subscribes.
  subscribedAt DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@index([subscribedAt])
}

/// A newsletter campaign created and sent from the admin panel. Drafts are
/// stored like any other campaign and simply never reach the send step.
model NewsletterCampaign {
  id              String                   @id @default(cuid())
  /// Email subject line.
  subject         String
  /// Banner title shown at the top of the message body.
  title           String
  /// Sanitized HTML body authored in the admin editor.
  content         String
  status          NewsletterCampaignStatus @default(DRAFT)
  recipientType   NewsletterRecipientType  @default(ALL_ACTIVE)
  /// Snapshot of chosen addresses when recipientType = SELECTED. Stored so a
  /// later change to the subscriber table cannot alter who actually got it.
  recipientEmails String[]
  /// Number of addresses the send targeted (computed when sending starts).
  recipientCount  Int                      @default(0)
  sentCount       Int                      @default(0)
  failedCount     Int                      @default(0)
  /// Optional call-to-action rendered below the content.
  ctaLabel        String?
  ctaUrl          String?
  createdById     String?
  /// Set when the send finishes (or the campaign is cancelled).
  sentAt          DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  createdBy       User?                    @relation("NewsletterCampaignCreatedBy", fields: [createdById], references: [id])

  @@index([status, createdAt])
  @@index([createdById])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
  MODERATOR
  VIEWER
}

enum CategoryKind {
  NEWS
  RESEARCH
  REGULATION
  PROJECT
  EVENT
  FOUNDER
}

enum ContentStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

/// What an inline visual is. Mirrors the writer's visual brief, minus `none`,
/// which produces no row at all.
enum ArticleVisualType {
  PHOTO
  CHART
  INFOGRAPHIC
  TIMELINE
}

/// Where a visual sits in the article. The hero image stays on
/// `Article.featuredImageId`; this is for everything that appears in the body.
enum ArticleVisualPlacement {
  HERO
  INLINE
}

enum ProjectStatus {
  LIVE
  BETA
  TESTNET
  DEPRECATED
  /// Public submission awaiting editor approval. Hidden from public listings.
  PENDING
}

enum EventMode {
  ONLINE
  OFFLINE
  HYBRID
}

/// Where an AI-generated image stands with the visual reviewer.
///
/// Rejection is a state, not an absence: `null` would be indistinguishable
/// from "an ordinary uploaded file", and the Studio has to be able to show an
/// editor *why* a candidate cannot be used.
enum MediaReviewStatus {
  PENDING
  APPROVED
  REJECTED
  ERROR
}

enum AdStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  ROLE_CHANGE
  PERMISSION_CHANGE
  SETTINGS_CHANGE
}

enum AgentEnvironment {
  PRODUCTION
  STAGING
}

/// Lifecycle of one idempotent submission.
///
/// `PROCESSING` exists so a *concurrent* duplicate is distinguishable from a
/// *sequential* retry: the second caller sees work already in flight and backs
/// off rather than starting a second article.
enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum AgentPublishMode {
  DRAFT
  REVIEW
  SCHEDULED
  IMMEDIATE
}

enum WebhookEvent {
  PUBLISH_COMPLETED
  PUBLISH_FAILED
  VALIDATION_FAILED
  CONTENT_UPDATED
  CONTENT_DELETED
}

enum NewsletterStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum NewsletterCampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum NewsletterRecipientType {
  ALL_ACTIVE
  SELECTED
}

/// One operational event from the autonomous newsroom.
///
/// Telemetry only. Every editorial record — NewsCluster, ResearchReport,
/// ArticleDraft, AIJob — lives in the newsroom's own database and is referenced
/// here by id, never copied. This table exists so an editor can see what the
/// newsroom is doing; it is not a second copy of what the newsroom knows.
///
/// Written by the newsroom agent through POST /api/v1/agents/telemetry and read
/// by the admin dashboard. Retained for 7 days by NewsroomTelemetryCleanupTask:
/// at roughly 350 events per ten-minute cycle this table turns over about
/// 58,000 rows a day, so it is the one table in this schema that must not keep
/// everything.
model NewsroomEvent {
  /// Supplied by the newsroom, not generated here.
  ///
  /// This is the idempotency mechanism. The newsroom assigns the id once, when
  /// the event enters its delivery buffer, and reuses it on every retry — so a
  /// redelivered batch collides on the primary key and is skipped. No second
  /// unique constraint to keep in sync.
  id String @id @default(cuid())

  /// Event name from the newsroom's own taxonomy, e.g. RESEARCH_STARTED,
  /// ARTICLE_REJECTED, CYCLE_COMPLETE. Deliberately a string rather than an
  /// enum: the newsroom owns the vocabulary and must be able to add an event
  /// without a CMS migration.
  type String

  /// Correlates every event in one newsroom run.
  workflowId String?
  /// The story this concerns, in the newsroom's database.
  clusterId  String?
  /// The CMS article, once one exists.
  articleId  String?

  stage  String?
  status String?
  /// Publisher domain, for source-level events.
  source String?
  /// Model that did the work, e.g. nvidia/nemotron-3-super-120b-a12b.
  model  String?

  /// Stage duration, where the newsroom measured one.
  durationMs Int?

  /// Counts, reasons and scores. Size-capped on ingest.
  metadata Json?

  /// When the newsroom observed the event.
  ///
  /// Separate from `createdAt` because delivery is batched and retried, so
  /// insert order does not preserve event order. Timelines sort on this.
  occurredAt DateTime
  /// When the CMS stored it. The canonical timestamp for retention.
  createdAt  DateTime @default(now())

  /// Retention sweep, and the default "latest events" read.
  @@index([createdAt])
  /// Activity-stream filters by event kind.
  @@index([type, createdAt])
  /// Every event of one cycle, in order.
  @@index([workflowId, createdAt])
  /// One story's journey, for the cluster inspector.
  @@index([clusterId, createdAt])
}
