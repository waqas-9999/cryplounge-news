# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Postgres. Must be reachable at boot — the app fails fast otherwise.
DATABASE_URL="postgresql://neondb_owner:npg_2frxYVWJl4cz@ep-super-night-ayn83onr.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Generate each separately; they must differ:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-64-plus-random-hex-characters"
JWT_REFRESH_SECRET="replace-with-a-different-64-plus-random-hex-string"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma-separated frontend origins permitted to call this API.
CORS_ORIGINS=http://localhost:3000

# Storage provider: "local" (disk, dev default) or "cloudinary" (required in
# production/Vercel, where local disk is not persistent). Defaults to
# "cloudinary" automatically when VERCEL is set, "local" otherwise.
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760

# Public origin the API is reachable at, used to turn a locally stored
# file's relative path into an absolute URL. Only relevant when
# STORAGE_PROVIDER=local and you're not running on localhost. Ignored by the
# cloudinary provider, which already returns absolute URLs.
API_PUBLIC_URL=http://localhost:4000

# Required when STORAGE_PROVIDER=cloudinary (or when deployed to Vercel).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend, for canonical URLs and cache revalidation after publish.
FRONTEND_URL=https://cryplounge-news-two.vercel.app
REVALIDATE_SECRET="shared-secret-matching-the-frontend"

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

SWAGGER_ENABLED=true

# --------------------------------------------------------------------- mail --
# Outbound SMTP. Optional: leave SMTP_HOST unset and mail is disabled entirely
# (contact messages are still stored and readable in the admin panel).
# Setting SMTP_HOST requires SMTP_USER, SMTP_PASSWORD and MAIL_FROM.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cryploungeofficial@gmail.com
SMTP_PASSWORD=replace-with-your-smtp-app-password
# Optional. Defaults to true when SMTP_PORT is 465, false otherwise.
SMTP_SECURE=false
# Optional. Defaults to true (strict certificate verification). Set to false
# only behind a TLS-intercepting proxy that presents its own certificate.
SMTP_REJECT_UNAUTHORIZED=true
# Envelope sender. Must be an address the SMTP account may send as.
MAIL_FROM=cryploungeofficial@gmail.com
MAIL_FROM_NAME=CrypLounge
# Comma-separated staff addresses notified of contact form submissions.
CONTACT_NOTIFY_EMAILS=cryploungeofficial@gmail.com

# --- Google Analytics 4 (visitor metrics source of truth) --------------------
# Numeric property id from GA Admin > Property Settings. The `properties/`
# prefix is optional — both forms are accepted.
GA_PROPERTY_ID=

# PRODUCTION: the service-account key itself, as a single-line JSON string.
# Use this on Vercel and on the VPS — no key file on disk, nothing to lose on
# a rebuild. Never prefix it with NEXT_PUBLIC_.
GOOGLE_SERVICE_ACCOUNT_JSON=

# LOCAL DEVELOPMENT ONLY: absolute path to a service-account JSON key file,
# read by the Google client library itself. Ignored when the variable above is
# set. Do not use in production.
#
# Setup: create a service account in Google Cloud, enable the Google Analytics
# Data API, download the JSON key, then add the service account's email as a
# Viewer on the GA4 property. Without that last step every report returns 403.
#
# Both unset => the analytics endpoints fall back to the internal counters, and
# the API still boots.
GOOGLE_APPLICATION_CREDENTIALS=

# --- AI imagery service -------------------------------------------------
# The imagery API runs on the VPS and owns the NVIDIA credential. The CMS
# only needs to reach it: NVIDIA_API_KEY must never appear here.
# Leave both blank to disable generation; the Image Studio then reports the
# service as unconfigured rather than failing mid-request.
IMAGERY_API_URL=https://imagery.cryplounge.com
IMAGERY_API_KEY=
