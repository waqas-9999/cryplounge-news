# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Postgres. Must be reachable at boot — the app fails fast otherwise.
DATABASE_URL="postgresql://neondb_owner:npg_2frxYVWJl4cz@ep-super-night-ayn83onr.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Generate each separately; they must differ:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-64-plus-random-hex-characters"
JWT_REFRESH_SECRET="replace-with-a-different-64-plus-random-hex-string"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma-separated frontend origins permitted to call this API.
CORS_ORIGINS=http://localhost:3000

# Local file storage.
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760

# Frontend, for canonical URLs and cache revalidation after publish.
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET="shared-secret-matching-the-frontend"

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

SWAGGER_ENABLED=true
